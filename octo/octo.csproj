<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Octo</RootNamespace>
        <!-- Dated releases. Version must be numeric for the assembly, so 07 loses its
             leading zero there; InformationalVersion carries the tag name verbatim and
             is what the dashboard shows. Bump both when tagging a release. -->
        <Version>2026.10.7</Version>
        <InformationalVersion>2026.10.07</InformationalVersion>
        <!-- Workstation GC, still concurrent: Octo serves a household, not a web farm. On the
             same load its memory peaked a third lower (237 MiB against 357) and idled 13 MiB
             lower, with no slower answers. DOTNET_gcServer=1 brings the server GC back. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Mirror Assets/ into wwwroot/Assets/ at build so the admin UI and
             cover-art watermarking can both reach the logo via the same
             bytes. wwwroot/Assets is what MapStaticAssets serves to the
             browser (cover art reads from /app/Assets via filesystem). -->
        <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest"
                 Link="wwwroot/Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The list cover design, shared with the Octo apps, with its fonts and painted
             backgrounds, inside the assembly so no publish layout can lose them. The font
             licence ships beside the app as the OFL asks. -->
        <Content Remove="Services\CoverArt\Design\**\*.json" />
        <EmbeddedResource Include="Services\CoverArt\Design\*.json" LogicalName="Octo.CoverDesign.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Services\CoverArt\Design\Fonts\*.ttf" LogicalName="Octo.CoverDesign.Fonts.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Services\CoverArt\Design\Backgrounds\*" LogicalName="Octo.CoverDesign.Backgrounds.%(Filename)%(Extension)" />
        <None Include="Services\CoverArt\Design\Fonts\OFL.txt" Link="licenses/Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <!-- Candidate matching decides which recording a peer sends us, and its rules are
             easiest to pin at the unit level against known-bad real-world filenames. -->
        <InternalsVisibleTo Include="octo.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
        <PackageReference Include="TagLibSharp" Version="2.3.0" />
    </ItemGroup>

</Project>
