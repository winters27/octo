# ===== OCTO CONFIGURATION =====
# Environment variables for deployment (Docker Compose, systemd, etc.)
# These override the values in appsettings.json.
#
# How Octo fits in: your Subsonic client talks to OCTO, and Octo talks to your
# existing Navidrome. So the one thing you MUST do:
#   >>> Point your music app at Octo (port 5274), NOT at Navidrome. <<<
# That is the only way any of this works. If an app points straight at Navidrome
# it bypasses Octo and you get plain Navidrome with no discovery or downloads.
#
# SUBSONIC_URL (your Navidrome) can be left blank: on first run Octo scans the
# local network and configures it automatically if it finds exactly one server.
# Set it explicitly to skip the scan or when auto-detect can't see your LAN
# (e.g. a Docker bridge network). Everything else has a working default;
# Soulseek or an existing Lidarr (downloads), and Last.fm (discovery/radio), are optional add-ons.
#
# NOTE: Use double-underscore (__) for nested properties in raw env keys.
# Example: Subsonic__Url maps to { "Subsonic": { "Url": "..." } }
# The keys below (UPPER_SNAKE) are the ones docker-compose.yml reads.

# ===== Your Navidrome server (auto-detected if left blank) =====
# Must be reachable from the Octo container: use a LAN IP or a docker service
# name, NOT localhost (inside the container localhost is Octo itself).
#   e.g. SUBSONIC_URL=http://192.168.1.10:4533
# Leave blank to let Octo find it on the network at first run.
SUBSONIC_URL=

# Optional Navidrome admin login. Lets Octo detect the music folder and run
# authenticated library rescans on its own. If blank, Octo instead learns an
# admin token the first time an admin signs in through it.
SUBSONIC_ADMIN_USERNAME=
SUBSONIC_ADMIN_PASSWORD=

# Auto-detect the download folder from Navidrome so downloads always land where
# Navidrome scans. Only adopts a path Octo can actually see; otherwise it uses
# DOWNLOAD_PATH below. Set false to always use DOWNLOAD_PATH verbatim.
AUTO_DETECT_DOWNLOAD_PATH=true

# TZ, for example America/Los_Angeles; listening stats and their week grid use it.
# Blank is UTC.
TZ=

# ===== OPTIONAL: playback / download behavior (safe defaults below) =====
# Ordinary external playback is local-first, then YouTube, and never downloads
# unless DOWNLOAD_ON_PLAY or LIDARR_ALBUM_ON_PLAY below say otherwise.
# STORAGE_MODE and DOWNLOAD_MODE no longer affect playback: they survive only
# for legacy direct-download jobs (playlists, cache fills). Hearts are the way
# tracks are acquired now — see DOWNLOAD_SOURCE and the admin Downloads page.
# Stream | Permanent | Cache (legacy jobs only)
STORAGE_MODE=Stream
# Track | Album (legacy jobs only)
DOWNLOAD_MODE=Track
# Initial defaults before a per-source heart matrix is saved in the admin UI.
DOWNLOAD_ON_STAR=true
# Star a whole album to fetch every track. Downloads run one at a time.
DOWNLOAD_ALBUM_ON_STAR=true
# Also fetch the whole album when a single song is starred, through the album heart sources.
DOWNLOAD_ALBUM_ON_SONG_STAR=false
# Keep a copy of every external track that is played, radio included, from the first song
# heart source Octo downloads from itself. Hearts go first; one played track waits at most.
DOWNLOAD_ON_PLAY=false
# Hand the album of every played external track to Lidarr, once per track until restart.
LIDARR_ALBUM_ON_PLAY=false
# Record which Subsonic user asked for each download, so on a shared library you can
# tell one person's acquisitions from another's. Off stops the name being captured at
# all rather than hiding it later. Entries already written keep their names.
RECORD_REQUESTED_BY=true
# Also favorite a hearted song or album in Navidrome once it downloads, for whoever hearted
# it. Off by default: a heart on a song you do not have only downloads it, and you heart it
# again once it is in the library. A heart on a song you already have is always a favorite.
# Octo's own apps are left out, since their star is the Add button.
STAR_DOWNLOADS_FOR_REQUESTER=false
# Never download a song already in the library. A lossy copy is kept and queued for a
# higher quality one when Soulseek or Lidarr can look for it and Better quality is on.
# Hearts through Lidarr too: the album's songs you already have are taken back out.
SKIP_OWNED_SONGS=true
# Off: missing tracks play immediately from YouTube and hearts acquire permanent
# copies. On: the first play fetches and waits for a lossless copy, which can take
# minutes and which most clients will give up on. Restart required, since it also
# changes what searches advertise for external tracks.
WAIT_FOR_LOSSLESS_ON_PLAY=false
# With the wait on: 0 waits as long as the fetch needs; above 0, playback falls back
# to the streaming preview after this many seconds while the download finishes in
# the background. The fallback serves lossy audio under a track advertised lossless,
# which strict clients can refuse to start.
LOSSLESS_WAIT_TIMEOUT_SECONDS=0
# Flat     = "Artist - Title.flac", everything in one directory
# ByArtist = "Artist/Title.flac", one folder per artist and no album folder
# Organized = "Artist/Album/01 - Title.flac"
# ByArtist suits a library built a track at a time, where Organized makes a folder
# per single. The album is in the tags either way, so the server still shows it.
FOLDER_STRUCTURE=Flat
# Set true when DOWNLOAD_PATH is a cloud/FUSE mount (rclone, pCloud)
USE_LOCAL_STAGING=false
# All | ExplicitOnly | CleanOnly
EXPLICIT_FILTER=All
CACHE_DURATION_HOURS=1
ENABLE_EXTERNAL_PLAYLISTS=false
# Off, search3/search2 returns only local library matches: no wait on Deezer/Last.fm,
# and every result plays straight from Navidrome instead of resolving through the
# YouTube shim. getTopSongs and Popular right now then list only library songs too.
# Radio and Last.fm's own discovery stations are unaffected either way.
ENABLE_SEARCH_DISCOVERY=true
# Off, search answers without waiting for the YouTube lengths of the top discovery rows,
# which saves a few seconds per new query. Those rows show Deezer's length; apps that
# look the song up again when it plays get the YouTube one once it has been found.
WAIT_FOR_SEARCH_DURATIONS=true
# How long, in milliseconds, a search waits for those YouTube lengths (0 to 10000; 0 never
# waits). Rows whose length arrives in time show it. The others show Deezer's length and get
# the YouTube one in the background, so getSong and the next search for the same words carry
# it. A longer wait shows more exact lengths on a new search but answers later.
# WAIT_FOR_SEARCH_DURATIONS=false means 0.
SEARCH_DURATION_WAIT_MS=1000
# How long, in milliseconds, a search waits for Last.fm's track search (0 to 10000; 0 waits
# however long Last.fm takes). Past it, the outside songs come from Deezer's own track search
# for the words, in Deezer's order. Last.fm's answer, when it arrives, is kept and used by
# the next search for the same words.
SEARCH_LASTFM_WAIT_MS=1000
# Outside songs listed without their stream size have it looked up in the background,
# so the next listing carries it. Each lookup costs YouTube one video lookup, so this
# many a minute at most (0 to 30); 0 turns the lookups off.
STREAM_SIZE_WARM_PER_MINUTE=5
# Covers of your own songs are read from Navidrome once and kept in Octo's config
# folder (cover-cache/); every size an app asks for is cut from that copy. This many
# megabytes at most (0 to 102400); the least recently shown go first. 0 turns the
# cover cache off.
COVER_CACHE_MB=1024
# Covers of songs, albums and artists that are not in your library yet carry a small
# octopus in other apps, so you can tell them apart: a heart on one downloads it.
# false shows them plain. Your own covers never carry it, and Octo's apps mark these
# songs their own way.
COVER_BADGE=true
# Apps that hide a song with no file size, by the name they send (comma-separated,
# ignoring case). Until Octo knows an outside song's real size, these apps get 1,
# which they read as "this song is here". Every other app is unchanged. Empty turns
# this off.
SIZE_FLAG_CLIENTS=Amperfy

# Where downloaded FLACs land on the HOST. This directory is bind-mounted as
# /music into the octo, yt-dlp-shim, and slskd containers, so downloaded files
# and Navidrome scans all see the same library. This is the
# only path you change to move the library; container-side settings (Octo's
# Library__DownloadPath, slskd's downloads dir) stay /music and normally never
# change. On Windows use forward slashes, e.g. DOWNLOAD_PATH=E:/Media/Music
DOWNLOAD_PATH=./downloads

# Initial heart-acquisition behavior for existing/env-only installs. The admin
# Downloads page can replace this with an ordered per-heart-type source list.
# Lidarr stays last by default and fetches a full album even for a track heart.
DOWNLOAD_SOURCE=Soulseek

# ===== SOULSEEK (slskd) — permanent FLAC source on star =====
# slskd web UI / API admin credentials. Octo authenticates against /api/v0/session
# with these. They are *not* your Soulseek account credentials — see SOULSEEK_*
# below for those.
SLSKD_USERNAME=slskd
SLSKD_PASSWORD=slskd
# Soulseek results only become readable from slskd around the 20s mark; at 6s
# every star silently fell back to a YouTube MP3 while lossless copies sat unseen.
SLSKD_SEARCH_WAIT_SECONDS=30
# How long Better quality and the weekly upgrade search Soulseek, in seconds (30 to 300).
SLSKD_UPGRADE_SEARCH_WAIT_SECONDS=90
SLSKD_MIN_FILE_SIZE_BYTES=5242880
SLSKD_PREFERRED_EXTENSION=flac
# How long a download may send nothing before Octo cancels it and tries the next
# of up to five peers. A slow peer that keeps sending is waited for, up to an hour.
SLSKD_DOWNLOAD_TIMEOUT_SECONDS=180

# Fingerprint every finished download with Chromaprint and ask AcoustID what it
# actually is. A peer that sends a different recording gets that file remembered
# and never tried again, for any track. Off by default. A track with no AcoustID
# entry is always accepted, never rejected: obscure music is the point of Soulseek.
SLSKD_VERIFY_DOWNLOADS=false
# Never download a cover, a karaoke backing track or an instrumental, even when a
# title asks for one, and leave such outside songs out of search, radio, mixes and
# charts. On by default. Off: a download is one only when its title asks for it,
# and such outside songs are listed again.
SKIP_COVERS_AND_INSTRUMENTALS=true
# Free application key from https://acoustid.org/new-application
ACOUSTID_API_KEY=
# How sure AcoustID must be before its answer may reject a file, as a percent.
# Raising this makes Octo MORE permissive: weaker matches are ignored, not acted on.
SLSKD_MIN_MATCH_SCORE=85
# On a confident match, write MusicBrainz's title/artist/album/year over the
# peer's own tags instead of trusting them.
SLSKD_TAG_FROM_MUSICBRAINZ=false
# On a confident match, also NAME the file from the matched recording: artist
# folder, title, album and track number, so the path and the tags agree. Only
# files Octo downloads and confirms; nothing already in the library is renamed.
NAME_FROM_MATCH=false
# How long a rejected peer+file is remembered. 0 never forgets.
SLSKD_REJECTED_PEER_DAYS=30
# Seconds of audio to fingerprint, and how long fpcalc and AcoustID each may take.
SLSKD_FINGERPRINT_SECONDS=120
SLSKD_FINGERPRINT_TIMEOUT_SECONDS=30
SLSKD_ACOUSTID_TIMEOUT_SECONDS=10
# Hours a heart waits while slskd is up but not logged in to Soulseek (the
# Soulseek server's maintenance), before it uses the next source. 0 means do not wait.
SLSKD_OUTAGE_HOLD_HOURS=6
# Downloads that may transfer at once (1 to 6). Each lands in its own folder, and
# Octo keeps to one at a time until slskd has proven it. 1 is the old behaviour.
SLSKD_PARALLEL_DOWNLOADS=3
# An album heart takes one peer's folder of the album in one batch, then searches
# song by song only for what it lacks. false is the old song by song walk.
SLSKD_ALBUM_FOLDERS=true
# Send AcoustID the fingerprints you confirmed with Keep, so the next person who
# downloads that recording gets a confident match. Only unambiguous recordings,
# never in a dry run. Needs your personal key from acoustid.org (after signing in),
# which is separate from the application key above.
ACOUSTID_SUBMIT=false
ACOUSTID_USER_KEY=

# Your Soulseek (Soulseek-network) account. Required for slskd to actually
# connect to peers and download. Sign up at https://www.slsknet.org/ if needed.
SLSKD_SOULSEEK_USERNAME=
SLSKD_SOULSEEK_PASSWORD=

# ----- Sharing back -----
# Soulseek runs on sharing, and many users will not send files to someone who
# shares nothing. With this on, slskd shares your music library read-only:
# DOWNLOAD_PATH is mounted a second time at /share, read-only, and shared as a
# folder named Music. This is where the dashboard's Share my library switch
# (Soulseek page) starts; flipping the switch wins from then on. false shares
# nothing. Left out of .env it is off, so an update never starts sharing by
# itself.
SLSKD_SHARE_LIBRARY=true
# What is shared while sharing is on, as slskd sees the folders, separated by
# ";". [Music]/share;!/share/Voice Memos keeps one folder out.
SLSKD_SHARED_DIR=[Music]/share
# How often slskd looks through the shared folders again, in minutes (60 or
# more), so new songs are shared. On a cloud drive, 10080 (weekly) is kinder.
SLSKD_SHARE_RESCAN_MINUTES=1440
# Uploads at once, and their total speed in KiB/s (2048 is about 16 Mbit/s).
# Raise them if your connection has upload to spare.
SLSKD_UPLOAD_SLOTS=4
SLSKD_UPLOAD_SPEED_LIMIT=2048
# Other people connect to slskd on TCP port 50300 to download from you.
# Forward that port on your router to this machine. Never forward 5030 (slskd's
# web page). The dashboard's Soulseek page tests the port with Soulseek's own
# port test; false never asks it.
SLSKD_CHECK_PORT=true
# Where the dashboard's Open slskd button goes. Blank: this server's name on
# port 5030. Set it when you reach slskd another way, e.g. a reverse proxy.
SLSKD_WEB_URL=

# ===== LIDARR — optional existing-server alternative for hearts =====
# Lidarr must already have indexers and a download client. Configure these two,
# then choose its root folder and profiles from Octo's Lidarr admin page.
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER_PATH=
LIDARR_QUALITY_PROFILE_ID=0
LIDARR_METADATA_PROFILE_ID=0
# Accepted: hand off and continue. Imported: completion/failure notifications
# wait for files to appear. Both modes reconcile history and trigger a scan.
LIDARR_COMPLETION_MODE=Accepted
LIDARR_IMPORT_TIMEOUT_SECONDS=1800

# ===== SPOTIFLAC — optional, your own SpotiFLAC server as a download source =====
# Off by default. Octo includes no SpotiFLAC and no extensions: you run SpotiFLAC,
# give it the extension registry you choose and install an extension in it. To run
# SpotiFLAC's own image beside Octo, add spotiflac to COMPOSE_PROFILES above, set
# SPOTIFLAC_REGISTRIES and SPOTIFLAC_WEB_TOKEN, and use http://spotiflac:8000.
# Every file it brings is checked like a Soulseek download before it is kept.
SPOTIFLAC_ENABLED=false
SPOTIFLAC_URL=
# The token SpotiFLAC's page asks for. The spotiflac service starts with this one.
SPOTIFLAC_WEB_TOKEN=
# AfterSoulseek, BeforeSoulseek, or BeforeSoulseekForAsianScripts (first only for
# songs written in Chinese, Japanese, Korean or Thai script).
SPOTIFLAC_PLACEMENT=AfterSoulseek
# LOSSLESS, or HI_RES_LOSSLESS for hi-res where there is one.
SPOTIFLAC_QUALITY=LOSSLESS
# Your extension ids to try, in order, separated by commas. Blank: SpotiFLAC's order.
SPOTIFLAC_SERVICES=
# Octo's music folder as SpotiFLAC sees it, when that path differs. Blank: the same.
SPOTIFLAC_FOLDER=
SPOTIFLAC_TIMEOUT_SECONDS=600
SPOTIFLAC_AT_ONCE=2
# For the spotiflac service: your extension registry addresses, separated by commas.
SPOTIFLAC_REGISTRIES=
# For the spotiflac service: the port of SpotiFLAC's page, where extensions are installed.
SPOTIFLAC_PORT=8010

# ===== GET UPCOMING SONGS AHEAD: optional =====
# Off by default. Downloads the next songs of what is playing as FLAC before they play, while
# nothing else is downloading, into a folder outside the music folder. Octo's apps play them;
# other apps need WAIT_FOR_LOSSLESS_ON_PLAY. A heart keeps one without downloading again.
PREFETCH_ENABLED=false
# RadioOnly (song radio, stations, mixes) or All (every song you don't own coming up).
PREFETCH_SCOPE=RadioOnly
# Songs after the one playing (1 to 10), and how many download at once (1 to 3).
PREFETCH_COUNT=3
PREFETCH_AT_ONCE=1
# Space the folder may use, days an unplayed song is kept, and free space always left, in GB.
PREFETCH_CACHE_GB=20
PREFETCH_KEEP_DAYS=30
PREFETCH_MIN_FREE_GB=10
# Start nothing new once nobody has played anything for ten minutes.
PREFETCH_PAUSE_WHEN_STOPPED=true
# Where the songs are kept. Blank: prefetch beside settings.json.
PREFETCH_FOLDER=
# Keep the first songs of each mix, and as many at random, ready (1 to 20 each).
PREFETCH_KEEP_MIXES_READY=false
PREFETCH_KEEP_READY_COUNT=5

# ===== YT-DLP SHIM (preview-stream sidecar) — usually leave defaults =====
YTDLP_MAX_CONCURRENT=5
# How many of those slots stay out of reach of background work, so a play never
# waits behind prewarm. Must be less than YTDLP_MAX_CONCURRENT; it is clamped if
# not. Raising it makes plays snappier under load and discovery warm more slowly.
YTDLP_GATE_RESERVE=2
# How long background work waits for a slot before giving up (seconds).
YTDLP_BG_GATE_WAIT_SEC=10
YTDLP_SEARCH_CACHE_MAX=1024
YTDLP_URL_CACHE_MAX=512
YTDLP_URL_CACHE_TTL=3600
# The YouTube player client asked for stream URLs. visionos's play at once; blank uses
# yt-dlp's own, whose URLs play only 4 to 14 seconds after they are made.
YTDLP_PLAYER_CLIENT=visionos
# Threads serving requests; each playing outside song holds one for the whole song.
SHIM_THREADS=128

# ===== LAST.FM RADIO =====
# Get your API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# The shared secret Last.fm shows under the key, from the same app. Only needed to scrobble plays
# to Last.fm; each listener then connects on the dashboard's Last.fm page.
LASTFM_API_SECRET=
LASTFM_ENABLE_RADIO=true
LASTFM_RADIO_TRACK_COUNT=50
LASTFM_RADIO_CACHE_HOURS=24
# Personalized and pinned stations appear automatically in authenticated users' playlist lists.
LASTFM_ENABLE_PERSONALIZED_STATIONS=true
# Each personalized station type, on its own. The defaults are what Octo has always
# built. Set a count to 0 to switch that kind of station off entirely.
LASTFM_ENABLE_YOUR_MIX=true
LASTFM_ENABLE_DISCOVERY_MIX=true
LASTFM_ARTIST_STATION_COUNT=2
LASTFM_GENRE_STATION_COUNT=3
LASTFM_ENABLE_DISCOVERY_STATIONS=true
# Publish both representations independently. Playlists preserve normal track
# quality; internet radio is one continuous MP3 stream at the selected bitrate.
LASTFM_EXPOSE_AS_PLAYLISTS=true
LASTFM_EXPOSE_AS_STREAMS=true
LASTFM_RADIO_STREAM_BITRATE_KBPS=192
LASTFM_HISTORY_RETENTION_DAYS=90
LASTFM_DISCOVERY_PERCENT=35
LASTFM_REFRESH_INTERVAL_HOURS=12
LASTFM_MINIMUM_PLAYS=10

# ===== CHARTS =====
# The most played and newest songs as read-only playlists for every listener,
# in every app, made again every 6 hours, read from Apple Music's public web
# pages. Songs a listener has play from their library; the rest play right away
# and can be added with a heart. Outside songs follow ENABLE_SEARCH_DISCOVERY
# and EXPLICIT_FILTER. On whether or not the mixes below are.
#
# Popular right now: Apple Music's 50 most played songs in the chart country
# (Deezer's chart when Apple's cannot be read).
POPULAR_NOW=true
# More lists, in order: new (Best New Songs, Apple Music's 100 picks of the
# week), trending (Trending Songs) and Apple genre numbers, each a playlist
# named Top and the genre: 18 Hip-Hop/Rap, 14 Pop, 6 Country, 15 R&B/Soul,
# 21 Rock, 20 Alternative, 12 Latin, 7 Electronic, 17 Dance, 51 K-Pop,
# 11 Jazz, 5 Classical, 1153 Metal, 2 Blues, 24 Reggae, 22 Christian,
# 10 Singer/Songwriter, 16 Soundtrack. Empty for none.
CHARTS=new,trending,18,14,6
# Whose charts: auto (the country the server is in) or a two-letter country
# such as us, gb or jp.
CHART_COUNTRY=auto

# --- Radio sources ----------------------------------------------------------
# Radio asks these besides Last.fm and blends the answers. YouTube Music and
# ListenBrainz receive the artist and title of the song a radio starts from.
RADIO_YOUTUBE_MUSIC=true
RADIO_LISTENBRAINZ=true
# The ListenBrainz similarity dataset; blank is the one Navidrome uses.
# RADIO_LISTENBRAINZ_ALGORITHM=
# How far LB Radio reaches for artist and genre stations (with a ListenBrainz
# token): easy, medium or hard.
RADIO_LISTENBRAINZ_RADIO_MODE=easy
# Sounds alike: the octo-sonic service reads every song once (gently: one song, then
# a pause) to find songs that sound alike, and to make the song's transition profile,
# which the Octo apps use to blend one song into the next. On a network mount the first
# pass takes a while. false turns Sounds alike radio off; octo-sonic keeps running and
# still makes transition profiles, but no longer works out how songs sound.
RADIO_SOUNDS_ALIKE=true
RADIO_SONIC_PAUSE_SECONDS=2
RADIO_SONIC_URL=http://octo-sonic:8080
# CPUs octo-sonic may use; never more than the machine has, or it will not start.
SONIC_CPUS=1
# Who octo-sonic reads the music as; nobody by default. Set it when only the owner can read
# the music folder, e.g. 1000:1000.
# SONIC_USER=65534:65534
# Radio learns which sources each listener plays through or skips, and leans on
# those they keep. It stores counts per listener and source, nothing else.
RADIO_LEARN_FROM_LISTENING=true

# ===== MIXES =====
# Genre and decade playlists drawn from your own library, one set per listener,
# served by Octo like the radio stations and drawn again every REFRESH_HOURS.
# Nothing is written to Navidrome. A mix appears once its genre or decade has
# CREATE_AT tracks and goes only below REMOVE_BELOW, so one at the edge does not
# come and go. MAX_PER_ARTIST keeps a lopsided genre from becoming half an album.
MIXES_ENABLED=false
MIXES_GENRES=true
MIXES_DECADES=true
MIX_TRACK_COUNT=100
MIX_MAX_PER_ARTIST=3
MIX_CREATE_AT=20
MIX_REMOVE_BELOW=10
MIX_MAX_PLAYLISTS=20
MIX_REFRESH_HOURS=24
# Percent of each mix, and of Discovery Radio, kept for tracks new to you: never
# played, or added in the last MIX_NEW_DAYS. 0 changes nothing.
MIX_NEW_SHARE=0
MIX_NEW_DAYS=30
# How mixes are named; {0} is the genre or decade. Empty means "{0} Mix".
MIX_NAME_FORMAT=
# A mix per country the library's artists are from ("Spain Mix"), as MusicBrainz
# knows them. Needs MIXES_ENABLED. Octo looks up at most COUNTRY_LOOKUPS_PER_REFRESH
# artists every six hours in the background, so the first country mixes take a
# while. MIX_COUNTRIES limits them to some countries ("ES,JP"); empty means any.
# MIX_MAX_COUNTRY_PLAYLISTS comes on top of MIX_MAX_PLAYLISTS.
COUNTRY_MIXES=false
MIX_COUNTRIES=
MIX_MAX_COUNTRY_PLAYLISTS=5
COUNTRY_LOOKUPS_PER_REFRESH=200
# A mix per year ("1994 Mix"), the years with the most songs first. Needs
# MIXES_ENABLED. The counts cover up to 40,000 songs of each listener's library.
# MIX_MAX_YEAR_PLAYLISTS (1 to 30) comes on top of MIX_MAX_PLAYLISTS.
MIXES_YEARS=false
MIX_MAX_YEAR_PLAYLISTS=10
# A mix for each of a listener's MIX_ARTIST_COUNT (1 to 20) most played artists
# ("Radiohead Mix"): half the artist's own songs, half songs in the library by
# artists Last.fm calls similar (all the artist's own without a Last.fm key).
# Needs MIXES_ENABLED. An artist keeps their mix while they stay near the top,
# so the mixes do not change with every week's plays.
MIXES_ARTISTS=false
MIX_ARTIST_COUNT=5

# ===== MADE FOR YOU =====
# Three lists for each listener, on whether or not the mixes above are, made
# again every day from their own plays and shown on the Octo apps' Home:
#   New Releases  albums, EPs and singles from the artists they play most,
#                 released in the last NEW_RELEASE_WEEKS (from Deezer, no key)
#   Rediscover    songs they loved and have not played for REDISCOVER_MONTHS
#   Deep Cuts     songs played once or never, from the artists they play most
FOR_YOU_NEW_RELEASES=true
FOR_YOU_REDISCOVER=true
FOR_YOU_DEEP_CUTS=true
NEW_RELEASE_WEEKS=8
NEW_RELEASE_ARTISTS=50
REDISCOVER_MONTHS=6

# ===== IMPORT =====
# Playlists and liked songs from Spotify or any other service come in as a file (the
# dashboard's Import page walks through TuneMyMusic's free export), a public Spotify link,
# or a pasted list. No account or key is needed.
# How many missing songs the trickle starts in an hour, at most. 0 stops it.
IMPORTS_SONGS_PER_HOUR=20
# How often lists from a link that are kept as a playlist or fetching are read again. 0 is never.
IMPORTS_REFRESH_HOURS=6

# ===== GENRE NORMALIZATION =====
# Downloads arrive with whatever genre the source had: YouTube categories like
# "Music" or "People & Blogs", hyper-specific tags, or seven genres at once.
# Off by default. The mapping table is edited in the dashboard, not here.
GENRE_NORMALIZE=false
# How many genres a track may keep. The default keeps what is already there; set
# it to 1 if you want one broad genre per track for browsing.
GENRE_MAX=10
# What to write when everything normalises away to nothing.
# Clear REMOVES the genre, which is the point: without it the junk survives.
# Leave keeps whatever was there, Unknown writes GENRE_UNKNOWN_LABEL instead.
GENRE_ON_EMPTY=Clear
GENRE_UNKNOWN_LABEL=Unknown
# Where to look when a file has no usable genre: None, LastFm, or MusicBrainz.
# LastFm needs LASTFM_API_KEY set, but does not need radio enabled.
GENRE_FALLBACK=None
# How many files in a row may fail to be written before a re-tag run gives up.
# 0 never gives up. Which extensions a whole-library run walks is set in the dashboard.
GENRE_BACKFILL_MAX_FAILURES=25

# ===== LIBRARY ACTIONS =====
# Fix a wrong download from the player you are already using, by adding the track to
# an action playlist (or, if you turn it on, by rating it).
#
# OFF by default, and it stays inert even when on until you add at least one allowed
# user in the dashboard: an empty allowlist means NOBODY, never everybody. Removed
# files go to a quarantine folder rather than being deleted.
LIBRARY_ACTIONS_ENABLED=false
LIBRARY_ACTIONS_PLAYLISTS=true
# Star ratings as commands. Off, and worth leaving off: a star is a one-tap gesture
# with no confirmation in any client, and rating a track you dislike is ordinary.
LIBRARY_ACTIONS_RATINGS=false
# Do everything except touch a file, so the first run is a rehearsal you can read.
LIBRARY_ACTIONS_DRY_RUN=true
# Where removed files go, under the music folder. 0 days keeps them forever.
LIBRARY_ACTIONS_TRASH_DIR=.octo-trash
LIBRARY_ACTIONS_TRASH_DAYS=30
LIBRARY_ACTIONS_POLL_SECONDS=60
LIBRARY_ACTIONS_MAX_PER_CYCLE=20
LIBRARY_ACTIONS_KEEP_REPLACED=true
# Prefix on the action playlists, so they sort together.
LIBRARY_ACTIONS_PREFIX="🛠 "
# Octo's own questions. A Review playlist per allowed user, filled with downloads
# AcoustID could not settle; answer with Keep (5 stars), an action, or by removing
# the track. The prefix sorts Octo's playlists apart from the action playlists.
LIBRARY_ACTIONS_REVIEW=false
# Also check songs already in the library, this many an hour (0 is off). Only while nothing
# downloads, only the library keeper is asked, and at most 50 such questions wait at once.
LIBRARY_ACTIONS_REVIEW_SWEEP_PER_HOUR=0
LIBRARY_ACTIONS_REVIEW_SWEEP_OCTO_DOWNLOADS=false
# Replace a file the sweep finds is clearly another song instead of asking: AcoustID
# names a different song at or above SLSKD_MIN_MATCH_SCORE. It goes through Wrong song
# (which must be on), keeps to LIBRARY_ACTIONS_DRY_RUN and the allowlist, and leaves
# a note in Review.
# Another take of the same song, a wrong length or an unsure match is still asked about.
# At most PER_DAY (1 to 100) a day; after three failed replacements in a day the rest
# of the day's matches are asked about too.
LIBRARY_ACTIONS_REVIEW_SWEEP_AUTO_REPLACE=false
LIBRARY_ACTIONS_REVIEW_SWEEP_AUTO_REPLACE_PER_DAY=10
# Also replace a song AcoustID has never heard when its YouTube preview, one with the song's
# title, artist and length, sounds nothing like the file, through Wrong song, instead of asking.
# Off by default. The new file is checked like any download, against the same preview. Uses the
# same daily limit and breaker as above; needs Wrong song on and dry run off. A song with an
# ISRC tag, or that anyone starred or rated, is still asked about.
LIBRARY_ACTIONS_REVIEW_SWEEP_AUTO_REPLACE_PREVIEW=false
# Check this many library songs an hour against their audio (0 is off). Each is fingerprinted
# only while nothing downloads; what disagrees shows in Library health. Stray spaces are
# taken off by itself when library actions may change files; the rest waits for you.
LIBRARY_ACTIONS_TAG_CHECK_PER_HOUR=60
# A Duplicates playlist per allowed user: recordings the library holds more than
# once (same MusicBrainz recording, same version), the copy worth keeping first.
# Octo only points them out. The library is walked every SCAN_HOURS.
LIBRARY_ACTIONS_DUPLICATES=false
LIBRARY_ACTIONS_DUPLICATES_SCAN_HOURS=24
# Songs a week Octo tries to upgrade to lossless by itself, through Better quality. 0 is off.
LIBRARY_ACTIONS_UPGRADE_PER_WEEK=0
# Where Better quality looks for a lossless copy. Auto asks Soulseek first, then Lidarr
# for what Soulseek cannot find, using whichever is set up; Soulseek or Lidarr uses only that.
LIBRARY_ACTIONS_UPGRADE_SOURCE=Auto
LIBRARY_ACTIONS_NOTICE_PREFIX="▸ "
LIBRARY_ACTIONS_NOTICE_MAX=100
# Where a star rating is a command: Auto (Octo's playlists while Review or
# Duplicates is on, anywhere otherwise), NoticeOnly, or Global.
LIBRARY_ACTIONS_RATINGS_SCOPE=Auto

# ===== METADATA LANGUAGE =====
# Language for genre and other text fetched from metadata providers and
# written into file tags (Accept-Language code, e.g. en, de, fr).
# Empty = provider decides from the server's IP.
METADATA_LANGUAGE=en
# A download with no album from its source, Deezer or its own tags is filed as a
# single under its title, instead of joining Navidrome's one [Unknown Album].
# Never applied to a compilation (album artist Various Artists).
ALBUM_FROM_TITLE=true
# Cover art for downloads: the Cover Art Archive when a fingerprint named the
# release, then the catalog's own cover, then Deezer, iTunes and Last.fm.
COVER_ART_ARCHIVE=true
# Treat a non-square cover (a video thumbnail) as missing; when nothing better
# turns up, its centre square is used, which for a YouTube Topic upload is the
# real cover inside the letterbox.
REPLACE_VIDEO_COVERS=true
# Also write cover.jpg beside a download. Organized layout only, and only in a
# folder the download created, so no existing album's cover ever changes.
COVER_FILE=true
# Embed each cover at the full size it was found (often 3000 px from iTunes)
# instead of 1500 px. Every file carries its own copy, so this adds a few MB per
# song. cover.jpg always gets the full size.
FULL_SIZE_COVERS=false

# ===== RELEASE MATCHING =====
# Every download is matched against every release the fingerprint service, the
# music database and the catalog offer, weighed against what was asked for.
# File a song that arrived without an album under its original album, even when
# the file was ripped from a compilation or a later pressing. Off keeps the
# file's own album when it names one.
PREFER_ORIGINAL_ALBUM=true
# The year a song shows is its recording's first release, not the pressing it
# was matched to (a 2011 remaster of a 1991 album reads 1991).
YEAR_FROM_ORIGINAL_RELEASE=true
# Countries whose pressings win a tie, in order, as two-letter codes, for
# example "US, XW, GB". Empty means no preference.
PREFERRED_COUNTRIES=
# Ask MusicBrainz for the chosen release's label, catalogue number, barcode and
# track ids (one request per download), and search it by name when the
# fingerprint named nothing. Needs no key.
RELEASE_DETAILS_LOOKUP=true
# Measure each download's loudness and write ReplayGain track tags (album gain
# too for an album fetched whole). Decoded beside the lookups, so it rarely
# adds time.
REPLAYGAIN=true
# How long the measurement may take before the download goes on without it.
REPLAYGAIN_TIMEOUT_SECONDS=45
# Rehearse the matching: show what every download would be tagged as under
# Fetched songs, but write only what Octo wrote before.
TAG_REHEARSAL=false

# ===== MOVING COVERS =====
# Apple Music's animated album art in the Octo apps, read from each album's
# Apple Music page and kept for a month. direct: the apps play them from Apple's
# video network. relay: through Octo, so the apps reach nothing but this server.
# off: none.
ANIMATED_ART=direct

# ===== LYRICS =====
# A .lrc (synced) or .txt (plain) beside each download, and live lyrics for any
# song as it plays when the library has none.
LYRICS_FETCH=false
# Sources in order: song (the lyrics a song already has, in its tags or a file
# beside it), kugou (timed word by word for most songs, an unofficial API),
# lrclib (open, timed line by line), netease (synced, deep on non-Western and
# older music, but an unofficial API, so add it only if you want it), lyricsovh
# (plain text). Timed beats plain. Leave a source out and it is never contacted;
# song cannot be left out, and is first when it is not listed.
LYRICS_SOURCES=song,kugou,lrclib,lyricsovh
# A later source with word timing beats an earlier one with only line timing.
LYRICS_PREFER_WORD_TIMED=true
# Let "Find lyrics for the library" write lyrics files beside every library song,
# not only the ones Octo downloaded. Existing lyrics are never replaced.
LYRICS_WRITE_BESIDE_ALL=false
# Where found lyrics are saved: beside (a .lrc or .txt next to the song), inside
# (in the song's own tags, which rewrites the file and needs a Navidrome scan,
# which Octo asks for), or both. Lyrics Octo did not write are never replaced.
LYRICS_SAVE_TO=beside

# ===== NOTIFICATIONS (ntfy / Discord webhook) — both optional =====
# Push a message when Octo fetches (or fails to fetch) music. A transport is
# enabled simply by its URL being set; both empty = notifications off.
# ntfy: pick any unique topic name, subscribe to it in the ntfy app, and put the
# same URL here (e.g. https://ntfy.sh/octo-yourname). Token only for protected
# servers. Discord: Server Settings -> Integrations -> Webhooks.
NTFY_URL=
NTFY_TOKEN=
DISCORD_WEBHOOK_URL=
# Per-event toggles, also editable live in the admin dashboard.
NOTIFY_DOWNLOAD_STARTED=false
NOTIFY_DOWNLOAD_COMPLETED=true
NOTIFY_LOSSLESS_FALLBACK=true
NOTIFY_DOWNLOAD_FAILED=true
NOTIFY_ALBUM_COMPLETED=true

# ===== UPDATES =====
# Octo asks GitHub every 6 hours whether a newer release is out and shows it on
# the dashboard, with the release notes. Set false and Octo never contacts GitHub
# for this. UPDATES_REPO matters only to a fork with its own dated releases.
UPDATES_CHECK=true
UPDATES_REPO=winters27/octo
# Which published Octo, yt-dlp shim and octo-sonic images are pulled. Unset, it is
# the release this folder holds, which is right for a git clone. Set latest where
# docker-compose.yml was copied by hand, so it never stays on the release it came
# with (README, "Published images").
# OCTO_IMAGE_TAG=latest

# ===== DASHBOARD SIGN-IN =====
# The dashboard and its API need a sign-in with a Navidrome admin account. Locked out
# (Navidrome down, or its address wrong)? The one-time recovery code is in
# admin-recovery-code in Octo's config folder.
# off turns the sign-in off. Only do that behind a proxy that signs people in itself
# (Authelia, Authentik); otherwise anyone who can reach Octo can change it.
ADMIN_SIGN_IN=required
# A port of its own for the dashboard (blank: it shares Octo's port). See the
# commented ports line in docker-compose.yml.
ADMIN_PORT=

# ===== LOGS =====
# Octo's own lines are always logged. The two lines for every request a music app
# or the dashboard makes (LOG_LEVEL_ASPNETCORE) and those for the calls Octo makes
# to other services (LOG_LEVEL_HTTPCLIENT) are left out (Warning): they were most
# of the log, and writing them cost CPU. Information brings the request lines
# back, for example to see what a music app asks for (docker compose logs octo).
# The names are the ones earlier releases read, so an older .env keeps working.
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_HTTPCLIENT=Warning
# Docker keeps each container's log in files of at most LOG_MAX_SIZE, and only the
# newest LOG_MAX_FILES of them, so logs never fill the disk (30 MB per container).
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ===== STARTER STACK: a Navidrome of your own (optional) =====
# For anyone without a music server yet: Octo starts Navidrome beside itself,
# reading the same music folder. install.sh sets all of this when you answer
# "no" to "Do you already run Navidrome?". By hand:
#   COMPOSE_PROFILES=navidrome
#   SUBSONIC_URL=http://navidrome:4533
#   NAVIDROME_ADMIN_PASSWORD=<a long random password>
#   SUBSONIC_ADMIN_USERNAME=admin
#   SUBSONIC_ADMIN_PASSWORD=<the same password>
# The password creates Navidrome's "admin" user on its very first start only.
# Change it later in Navidrome's own pages (port 4533), then on the dashboard's
# Music server page so Octo keeps signing in.
COMPOSE_PROFILES=
NAVIDROME_ADMIN_PASSWORD=
# Navidrome's own pages and web player (music apps still go to 5274).
NAVIDROME_PORT=4533
# Where Navidrome keeps its database. Blank keeps it in ./navidrome-data.
NAVIDROME_DATA_DIR=

# ===== FOLDERS (optional) =====
# Where Octo's settings and state, and slskd's state, live on this machine.
# Blank keeps them inside this folder (./octo-config and ./slskd-state). Point
# them elsewhere to keep the Octo folder a clean copy of the code.
OCTO_CONFIG_DIR=
SLSKD_STATE_DIR=
